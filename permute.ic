Embark() {
    // Set up a string to permute
    Letter str[10];
    str[0] = 'A';
    str[1] = 'B';
    str[2] = 'C';
    str[3] = ' ';
    
    // Display the original string
    Emit("Original string: %c%c%c\n", str[0], str[1], str[2]);
    Emit("All permutations:\n");
    
    // Generate permutations
    generatePermutations(str, 0, 2);
}

// Method to generate all permutations of a string
Method Void generatePermutations(Missive text, Numeral start, Numeral end) {
    // Base case: if we've reached the end of the string
    Thou (start == end) {
        // Print the current permutation
        Emit("%c%c%c\n", text[0], text[1], text[2]);
        Recede 0;
    }
    
    // Try each character in the remaining positions
    Numeral i = start;
    Until (i <= end) {
        // Swap characters at positions start and i
        swapChars(text, start, i);
        
        // Recursively generate permutations for the rest
        generatePermutations(text, start + 1, end);
        
        // Backtrack by swapping characters back
        swapChars(text, start, i);
        
        // Move to next character
        i = i + 1;
    }
}

// Helper method to swap two characters in a string
Method Void swapChars(Missive text, Numeral i, Numeral j) {
    // Only swap if the positions are different
    Thou (i != j) {
        // Perform the swap
        Letter temp = text[i];
        text[i] = text[j];
        text[j] = temp;
    }
}