Method Void cubeIterations(Numeral num, Numeral iterations) {
	Per(Numeral i=1; i<= iterations; i++) {
		Numeral num = num*num*num;
		Emit("Iteration %d: %d\n", i, num);
	}
}

Embark() {
	Numeral number, iterations;

	Emit("Enter a number: ");
	Seek("%d", &number);
	Emit("Enter number of iterations: ");
	Seek("%d", &iterations);

	cubeIterations(number, iterations);
}