Embark() {
    Numeral score;
    Missive grade = " ";

	Emit("Enter your score: ");
	Seek("%d", &score);
    
    Shift(score) {
        Opt 100:
            grade = "Perfect Score";
            Emit("Perfect Score: A+\n");
            Halt;
        Opt 90:
            grade = "Excellent";
            Emit("Excellent: A\n");
            Halt;
        Opt 80:
            grade = "Very Good";
            Emit("Very Good: B\n");
            Halt;
        Opt 70:
            grade = "Good";
            Emit("Good: C\n");
            Halt;
        Opt 60:
            grade = "Pass";
            Emit("Pass: D\n");
            Halt;
        Usual:
            grade = "Needs Improvement";
            Emit("Needs Improvement: F\n");
    }
    
    Emit("Final grade: %s\n", grade);
}