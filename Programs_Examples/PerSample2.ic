Embark() {
	Emit("Example 1: Printing numbers from 1 to 10\n");
  Per (Numeral i = 1; i <= 10; i++) {
    Emit("%d ", i);
  }

	Emit("\n\nExample 6: Nested for loops to print a 3x3 grid\n");
  Per (Numeral i = 0; i < 11; i++) {
    Per (Numeral j = 0; j < 11; j++) {
      Emit("(%d, %d) ", i, j);
    }
    Emit("\n");
  }
}