Letter arr[10];
Numeral length;

Embark() {
    Emit("Enter a word: ");
    Seek("%s", &arr[0]);

    // Compute length up to the '\0' terminator
    length = 0;
    Per (Numeral i = 0; i < 10; i++) {
        Thou (arr[i] == "") {
            Halt;
        }
        length = length + 1;
    }

    // Kick off
    check(0, length - 1);

    Recede 0;
}

Method Void check(Numeral l, Numeral r) {
    Thou (l >= r) {
        Emit("Yes, it's a palindrome!\n");
        Recede 0;
    } Or {
        Thou (arr[l] != arr[r]) {
            Emit("No, not a palindrome.\n");
            Recede 0;
        } Or {
            check(l + 1, r - 1);
        }
    }
}