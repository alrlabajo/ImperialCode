Embark() {
    Numeral bin_num, decimal, base = 1, rem;
    
    Emit("Enter a binary number: ");
    Seek("%d", &bin_num);
    
    Until (bin_num > 0) {
        rem = bin_num % 10;
        decimal += rem * base;
        bin_num /= 10;
        base *= 2;
    }
    
    Emit("Decimal equivalent: %d\n", decimal);
}