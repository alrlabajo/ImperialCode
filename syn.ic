Method Void cubeIteration(Numeral num, Numeral iterations) {
	Per(Numeral i=1 ; i<=iterations; i++) {
		num = num*num*num;
		Emit("Iteration %v: %d\n", i, num);
	}
}

Embark() {
	Numeral number, iterations;

	Emit("Enter a number :");
	Seek("%d", &number);
	Emit("Enter number of iterations: ");
	Seek("%d", &iterations);

	cubeIteration(number, iterations);

	Recede 0;
}