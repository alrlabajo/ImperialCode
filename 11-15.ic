
//11. 
Method Void rightTriangle() {

  Emit("   *\n");
  Emit("  **\n");
  Emit(" ***\n");
  Emit("****\n");
}

//12. 
Method Void leftTriangle() {

  Emit("*\n");
  Emit("**\n");
  Emit("***\n");
  Emit("****\n");
}

//13. 
Method Void triangle() {
  Emit("   *\n");
  Emit("  ***\n");
  Emit(" *****\n");
  Emit("*******\n");
}

//14.
Method Void square() {
  Emit("*******\n");
  Emit("*******\n");
  Emit("*******\n");
  Emit("*******\n");
}

//15. 
Method Void rectangle() {
  Emit("************\n");
  Emit("************\n");
  Emit("************\n");
  Emit("************\n");
}

Embark() {
rightTriangle();
Emit("\n");
leftTriangle();
Emit("\n");
triangle();
Emit("\n");
square();
Emit("\n");
rectangle();
}