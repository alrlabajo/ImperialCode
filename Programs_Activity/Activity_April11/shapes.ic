Method Void rightTriangle(Numeral n) {
    Per (Numeral i = 1; i <= n; i++) {
        Per (Numeral j = 1; j <= i; j++) {
            Emit("* ");
        }
        Emit("\n");
    }
}

Method Void invertedTriangle(Numeral n) {
    Per (Numeral i = n; i >= 1; i--) {
        Per (Numeral j = 1; j <= i; j++) {
            Emit("* ");
        }
        Emit("\n");
    }
}

Method Void pyramid(int n) {
    Per (Numeral i = 1; i <= n; i++) {
        Per (Numeral j = i; j < n; j++) Emit(" ");
        Per (Numeral k = 1; k <= (2*i - 1); k++) Emit("*");
        Emit("\n");
    }
}

Method Void invertedPyramid(Numeral n) {
    Per (Numeral i = n; i >= 1; i--) {
        Per (Numeral j = i; j < n; j++) Emit(" ");
        Per (Numeral k = 1; k <= (2*i - 1); k++) Emit("*");
        Emit("\n");
    }
}

Method Void diamond(Numeral n) {
    pyramid(n);
    Per (Numeral i = n - 1; i >= 1; i--) {
        Per (Numeral j = i; j < n; j++) Emit(" ");
        Per (Numeral k = 1; k <= (2*i - 1); k++) Emit("*");
        Emit("\n");
    }
}

Embark() {
    Numeral choice, rows;

    Emit("Menu (6-10):\n");
    Emit("6 - Right Triangle\n");
    Emit("7 - Inverted Triangle\n");
    Emit("8 - Pyramid\n");
    Emit("9 - Inverted Pyramid\n");
    Emit("10 - Diamond\n");
    Emit("Enter choice: ");
    Seek("%d", &choice);

    Thou (choice >= 6 && choice <= 10) {
        Emit("Enter number of rows: ");
        Seek("%d", &rows);

        Thou (choice == 6) rightTriangle(rows);
        Or Thou (choice == 7) invertedTriangle(rows);
        Or Thou (choice == 8 ) pyramid(rows);
        Or Thou (choice == 9) invertedPyramid(rows);
        Or Thou (choice == 10) diamond(rows);
    } Or {
        Emit("Invalid choice!\n");
    }

}