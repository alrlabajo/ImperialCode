
Letter arr[10];
Numeral length;

Embark() {
    Emit("Enter a word: ");
    Seek("%s", &arr[0]);

    // Manual length detection
    Numeral i = 0;
    Until (arr[i] != "") {
        i = i + 1;
    }
    length = i;

    Emit("\nAll permutations:\n");
    permute(0, length - 1);

    Recede 0;
}






Method Void permute(Numeral l, Numeral r) {
    Thou (l == r) {
        Per (Numeral i = 0; i <= r; i++) {
            Emit("%c", arr[i]);
        }
        Emit("\n");
    } Or {
        Per (Numeral i = l; i <= r; i++) {
            swap(l, i);
            permute(l + 1, r);
            swap(l, i);
        }
    }
}

Method Void swap(Numeral i, Numeral j) {
    Letter temp;
    temp = arr[i];
    arr[i] = arr[j];
    arr[j] = temp;
}

