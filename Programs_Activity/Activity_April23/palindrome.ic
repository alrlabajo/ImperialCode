Letter arr[10];
Numeral i, j;
Veracity isPalindrome = Pure;

Embark() {
    Emit("Enter a word (end with #): ");
    Seek("%s", &arr[0]);

    // Detect length safely with limit
    Numeral length = 0;
    Until (length >= 10 | arr[length] == "#") {
        length = length + 1;
    }

    // Compare mirrored characters
    i = 0;
    j = length - 1;

    Until (i >= j) {
        Thou (arr[i] != arr[j]) {
            isPalindrome = Nay;
            Halt;
        }
        i = i + 1;
        j = j - 1;
    }

    Thou (isPalindrome == Pure) {
        Emit("It is a palindrome");
    } Or {
        Emit("It is not a palindrome");
    }
}
