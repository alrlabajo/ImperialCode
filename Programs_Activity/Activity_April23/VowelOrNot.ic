Embark() {
    Missive ch;

    Emit("Enter a letter: ");
    Seek("%c", &ch);  // Notice the space before %c to skip whitespace

    Thou(ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' ||
         ch == 'A' || ch == 'E' || ch == 'I' || ch == 'O' || ch == 'U') {
        Emit("'%c' is a vowel.\n", ch);
    } Or {
        Emit("'%c' is not a vowel.\n", ch);
    }

    Recede 0;
}
