Embark() {
    Numeral decValue = 5;
    Numeral bit0; 
    Decimal bit1;
    Decimal bit2;
    Decimal bit3;
    Decimal tempValue;

		 Emit("Converting Decimal %d to Binary...\n", decValue);

    bit0 = decValue % 2;      
    tempValue = decValue / 2;
    bit1 = tempValue % 2;    
    tempValue = tempValue / 2;

    bit2 = tempValue % 2;      // 3 % 2 = 1
    tempValue = tempValue / 2; // 3 / 2 = 1

    bit3 = tempValue % 2;      // 1 % 2 = 1
    Emit("Binary representation (4-bit): %d%d%d%d\n", bit3, bit2, bit1, bit0);
}