Embark() {
    Numeral binary, decimal=0, digit, weight=1;
    
    Emit("Enter a binary number: ");
    Seek("%d", &binary);
    
    Numeral original = binary;
    
    Until(binary > 0) {
        digit = binary % 10;  // Get rightmost digit
        
        // Check if digit is valid (0 or 1)
        Thou(digit > 1) {
            Emit("Invalid binary digit. Binary can only contain 0 and 1.\n");
            Emit("Enter a binary number: ");
            Seek("%d", &binary);
            original = binary;
            binary = binary;
            digit = binary % 10;
        } Or {
            // Proceed with conversion for valid digit
            decimal = decimal + (digit * weight);
            weight = weight * 2;
            binary = binary / 10;  // Remove rightmost digit
        }
    }


    
    Emit("The decimal equivalent of %d is %d\n", original, decimal);
}