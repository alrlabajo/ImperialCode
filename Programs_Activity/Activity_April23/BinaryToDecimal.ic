Embark() {
    Numeral binary, decimal=0, digit, weight=1;
		Numeral hexDigits[20];
    Numeral i = 0;
    Numeral remainder = 0;
    Numeral isNegative = 0;
    
    Emit("Enter a binary number: ");
    Seek("%d", &binary);
    
    Numeral original = binary;
    
    Until(binary > 0) {
        digit = binary % 10; 

        Thou(digit > 1) {
            Emit("Invalid binary digit. Binary can only contain 0 and 1.\n");
            Emit("Enter a binary number: ");
            Seek("%d", &binary);
            original = binary;
            binary = binary;
            digit = binary % 10;
        } Or {
            decimal = decimal + (digit * weight);
            weight = weight * 2;
            binary = binary / 10;
        }
    }
    Emit("The decimal equivalent of %d is %d\n", original, decimal);

}